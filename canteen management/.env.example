# ==============================================================================
# CANTEEN MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# The application works out-of-the-box in local reactive mode without any .env file.
# To connect to your live Supabase cloud PostgreSQL database:
# 1. Create a project at https://supabase.com
# 2. Run the SQL script found in `supabase/schema.sql` in your Supabase SQL Editor
# 3. Copy your project credentials from Project Settings -> API and set them below
# 4. Rename this file to `.env` or `.env.local` and restart the Vite dev server

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

